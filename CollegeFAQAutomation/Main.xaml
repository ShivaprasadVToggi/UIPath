  <Sequence DisplayName="Main Sequence" sap2010:Annotation.AnnotationText="College Enquiry System - reads FAQ Excel, asks for keyword, displays matching answer">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Boolean" Name="answerFound" Default="False" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtFAQ" />
      <Variable x:TypeArguments="x:String" Name="searchKeyword" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtCSV" />
      <Variable x:TypeArguments="x:String" Name="csvDemoOutput" />
    </Sequence.Variables>

    <!-- 1. Excel Application Scope (CollegeFAQ.xlsx) -> Read Range Sheet1, Has headers = True -> dtFAQ -->
    <ui:ExcelApplicationScope Password="{x:Null}" DisplayName="Excel Application Scope: CollegeFAQ.xlsx"
                              WorkbookPath="CollegeFAQ.xlsx"
                              Visible="False"
                              CreateNewFile="False"
                              ReadOnly="True"
                              AutoSave="False">
      <ui:ExcelApplicationScope.Body>
        <ActivityAction x:TypeArguments="ui:WorkbookApplication">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ui:WorkbookApplication" Name="ExcelWorkbookScope" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Excel Activities Sequence">
            <ui:ExcelReadRange DisplayName="Read Range: Sheet1"
                               SheetName="Sheet1"
                               AddHeaders="True"
                               Range=""
                               DataTable="[dtFAQ]" />
          </Sequence>
        </ActivityAction>
      </ui:ExcelApplicationScope.Body>
    </ui:ExcelApplicationScope>

    <!-- 2. Write Line: display row count -->
    <ui:WriteLine DisplayName="Write Line: Row Count"
                  Text="[&quot;Total FAQ rows loaded from Excel: &quot; + dtFAQ.Rows.Count.ToString]" />

    <!-- 3. Read CSV + String.Join output demo -->
    <ui:ReadCsvFile DataTable="[dtCSV]"
                    Delimitator="Comma"
                    DisplayName="Read CSV: faq_data.csv"
                    FilePath="faq_data.csv"
                    IncludeColumnNames="True" />
    <Assign DisplayName="Assign: csvDemoOutput = String.Join(...)">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[csvDemoOutput]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Join(" | ", dtCSV.AsEnumerable().Select(Function(r) r("Question").ToString()).ToArray())]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:WriteLine DisplayName="Write Line: CSV Questions Demo"
                  Text="[&quot;CSV demo - all questions: &quot; + csvDemoOutput]" />

    <!-- 4. Input Dialog: ask for keyword / question / category -->
    <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}"
                    DisplayName="Input Dialog: College Enquiry"
                    Title="College Enquiry System"
                    IsPassword="False"
                    Label="Enter keyword, question, VisitorFAQ or StudentFAQ:">
      <ui:InputDialog.Result>
        <OutArgument x:TypeArguments="x:String">[searchKeyword]</OutArgument>
      </ui:InputDialog.Result>
    </ui:InputDialog>

    <!-- 5. Assign: answerFound = False -->
    <Assign DisplayName="Assign: answerFound = False">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Boolean">[answerFound]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Boolean">False</InArgument>
      </Assign.Value>
    </Assign>

    <!-- 6. For Each Row in Data Table (dtFAQ), item name: CurrentRow -->
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}"
                   DataTable="[dtFAQ]"
                   DisplayName="For Each Row in Data Table: dtFAQ">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Row Processing Sequence">
            <!-- If: keyword matches Question or Category (case-insensitive) -->
            <If DisplayName="If: keyword matches Question or Category"
                Condition="[searchKeyword IsNot Nothing AndAlso (searchKeyword.Trim().ToLower().Contains(CurrentRow(&quot;Question&quot;).ToString().ToLower()) OrElse CurrentRow(&quot;Question&quot;).ToString().ToLower().Contains(searchKeyword.Trim().ToLower()) OrElse searchKeyword.Trim().ToLower().Equals(CurrentRow(&quot;Category&quot;).ToString().ToLower()) OrElse CurrentRow(&quot;Category&quot;).ToString().ToLower().Contains(searchKeyword.Trim().ToLower()))]">
              <If.Then>
                <Sequence DisplayName="Match Found Sequence">
                  <ui:MessageBox Caption="College FAQ Answer"
                                 Buttons="Ok"
                                 ChosenButton="{x:Null}"
                                 DisplayName="Message Box: Show Answer"
                                 Text="[CurrentRow(&quot;Answer&quot;).ToString()]" />
                  <Assign DisplayName="Assign: answerFound = True">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Boolean">[answerFound]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Boolean">True</InArgument>
                    </Assign.Value>
                  </Assign>
                </Sequence>
              </If.Then>
              <If.Else>
                <Sequence DisplayName="Else" />
              </If.Else>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>

    <!-- 7. After loop: If Not answerFound -> Message Box -->
    <If DisplayName="If: Not answerFound"
        Condition="[Not answerFound]">
      <If.Then>
        <Sequence DisplayName="Then">
          <ui:MessageBox Caption="College Enquiry System"
                         Buttons="Ok"
                         ChosenButton="{x:Null}"
                         DisplayName="Message Box: No Match"
                         Text="[&quot;No matching answer found / Invalid Category&quot;]" />
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else" />
      </If.Else>
    </If>

  </Sequence>
</Activity>
